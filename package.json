{
  "name": "neuro-ads-manager",
  "version": "0.2.0",
  "description": "Gestor de tráfego pago para agentes de IA: auditoria de conta, plano de campanha, relatório, criativos e copy, e conferência de conversão (pixel, CAPI e offline), com as boas práticas de mercado e padrões validados em projetos reais. Compliance por segmento (OAB, ECA/LGPD, saúde, financeiro).",
  "main": "harness/index.mjs",
  "exports": {
    ".": "./harness/index.mjs",
    "./cordis.patch.yml": "./harness/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "neuro-ads-manager": "./cli/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monrars1995/oneuros-ads-manager.git"
  },
  "keywords": [
    "paid-media",
    "traffic-manager",
    "meta-ads",
    "facebook-ads",
    "instagram-ads",
    "google-ads",
    "conversions-api",
    "offline-conversions",
    "compliance",
    "oab",
    "lgpd",
    "eca",
    "claude-skill",
    "deepseek-harness",
    "neuro-harness",
    "pt-br"
  ],
  "author": "Ramon Ribeiro <204264780+monrars1995@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/monrars1995/oneuros-ads-manager/issues"
  },
  "homepage": "https://github.com/monrars1995/oneuros-ads-manager#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin",
    "cli",
    "commands",
    "agents",
    "harness",
    "skills",
    ".claude-plugin",
    "plugin.json",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./harness/cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "version:check": "node cli/version.js check",
    "version:set": "node cli/version.js set"
  }
}
